# k3s server(시스템 노드) 설정. Jeong 작성, 정답본.
# Terraform 이 넘겨 주는 값: token
# 문서: https://docs.k3s.io/cli/server  (여기 있는 --옵션 이름에서 -- 를 뺀 것이 YAML 키)

# 노드들이 이 서버에 붙을 때 내야 하는 비밀번호. agent 쪽 token 과 같아야 한다
token: "${token}"

# /etc/rancher/k3s/k3s.yaml (kubeconfig) 권한. 0600 = root 만. 스크립트는 sudo 로 읽는다
write-kubeconfig-mode: "0600"

# 노드 라벨: "이 노드는 어떤 풀인가" 를 파드가 nodeSelector 로 고를 수 있게
node-label:
  - "pool=system"
  - "capacity-type=on-demand"

# 노드 taint: 아무 파드나 여기 오지 못하게.
# CriticalAddonsOnly 는 k3s 기본 부품(coredns·traefik·metrics-server·local-path)이 이미 견디는(tolerate) 키라서
# 이 taint 를 걸어도 클러스터 기본 기능은 그대로 여기 뜬다. 함수 파드는 못 온다.
# NoExecute = 새로 못 오는 것 + 이미 있던 것도 쫓아냄. (NoSchedule 은 새로 못 오는 것만)
node-taint:
  - "CriticalAddonsOnly=true:NoExecute"

# 끄는 기본 부품 없음. traefik(인그레스), servicelb(LoadBalancer 를 노드 포트로), local-storage, metrics-server 그대로 쓴다.
# Cilium 으로 바꾸려면 여기서 flannel-backend: "none", disable-network-policy: true 가 필요하다 (README 셀프 연습).
