#!/bin/bash
# EC2 첫 부팅 때 root 로 한 번 실행되는 스크립트 (user_data). Jeong 작성, 정답본.
# Terraform(k3s.tf)이 이 파일을 templatefile() 로 읽어서 아래 세 자리를 채운다.
#   role        = "server" 또는 "agent"
#   k3s_channel = "stable" 등
#   config      = server-config.yaml.tftpl 또는 agent-config.yaml.tftpl 을 채운 결과 (YAML 문자열)
# 주의: 이 파일 안에서 셸 변수 중괄호를 쓰려면 앞에 $ 를 하나 더 붙여 이스케이프한다.
#       Terraform 이 자기 자리표시자로 착각하기 때문 (README 4.1 참고).
# 문서: https://docs.k3s.io/installation/configuration#configuration-file
#       https://docs.k3s.io/reference/env-variables

set -euo pipefail

# 이 스크립트의 출력 전부를 로그 파일에도 남긴다. 안 뜨면 이 파일부터 본다:
#   sudo tail -n 50 /var/log/k3s-bootstrap.log
exec > >(tee -a /var/log/k3s-bootstrap.log) 2>&1
echo "[bootstrap] role=${role} start $(date -u +%Y-%m-%dT%H:%M:%SZ)"

# 1) k3s 설정 파일. k3s 는 시작할 때 /etc/rancher/k3s/config.yaml 을 자동으로 읽는다.
#    명령줄 옵션(--node-label ...)을 길게 쓰는 대신 파일 하나에 모은다.
mkdir -p /etc/rancher/k3s
cat > /etc/rancher/k3s/config.yaml <<'K3SCONFIG'
${config}
K3SCONFIG
chmod 600 /etc/rancher/k3s/config.yaml   # 토큰이 들어 있어서 root 만 읽게

%{ if role == "agent" ~}
# 1-2) kubelet 설정 파일 (graceful node shutdown). agent-config.yaml 의 kubelet-arg "config=" 가 이 파일을 가리킨다.
#      kubelet 의 명령줄 플래그가 아니라 설정 파일 필드라서 따로 파일로 둔다.
cat > /etc/rancher/k3s/kubelet.yaml <<'KUBELET'
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
shutdownGracePeriod: 60s
shutdownGracePeriodCriticalPods: 10s
KUBELET
%{ endif ~}

# 2) 공식 설치 스크립트. 바이너리 설치 + systemd 서비스(k3s 또는 k3s-agent) 등록 + 시작까지 한다.
#    마지막 인자 server/agent 가 어느 쪽으로 설치할지 정한다.
curl -sfL https://get.k3s.io | INSTALL_K3S_CHANNEL='${k3s_channel}' sh -s - ${role}

echo "[bootstrap] role=${role} done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
